services:
  app:
    image: {{ services.image }}
    container_name: swiftdeploy-app
    environment:
      MODE: "{{ services.mode }}"
      APP_VERSION: "{{ services.version }}"
      APP_PORT: "{{ services.port }}"
    networks:
      - {{ network.name }}
    volumes:
      - {{ volumes.logs }}:/app/logs
    restart: {{ services.restart_policy }}
    user: "appuser"
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    expose:
      - "{{ services.port }}"
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:{{ services.port }}/healthz')"]
      interval: 10s
      timeout: 5s
      retries: 6
      start_period: 10s

  nginx:
    image: {{ nginx.image }}
    container_name: swiftdeploy-nginx
    ports:
      - "{{ nginx.port }}:{{ nginx.port }}"
    volumes:
      - {{ nginx_conf_path }}:/etc/nginx/nginx.conf:ro
      - {{ volumes.logs }}:/var/log/nginx
    networks:
      - {{ network.name }}
    restart: {{ services.restart_policy }}
    depends_on:
      app:
        condition: service_healthy

networks:
  {{ network.name }}:
    name: {{ network.name }}
    driver: {{ network.driver_type }}

volumes:
  {{ volumes.logs }}:
    name: {{ volumes.logs }}
