# Paths 

ROOT        = os.path.dirname(os.path.abspath(__file__))
MANIFEST    = os.path.join(ROOT, "manifest.yaml")
TMPL_DIR    = os.path.join(ROOT, "templates")
GEN_DIR     = os.path.join(ROOT)
NGINX_CONF  = os.path.join(GEN_DIR, "nginx.conf")
COMPOSE     = os.path.join(GEN_DIR, "docker-compose.yml")
HISTORY     = os.path.join(ROOT, "history.jsonl")
AUDIT_REPORT= os.path.join(ROOT, "audit_report.md")

REQUIRED_FIELDS = {
    "services": ["image", "port"],
    "nginx":    ["image", "port"],
    "network":  ["name", "driver_type"],
    "opa":      ["policies_dir", "host", "port"],
}

# Colours 

GREEN  = "\033[32m"
RED    = "\033[31m"
YELLOW = "\033[33m"
CYAN   = "\033[36m"
RESET  = "\033[0m"
BOLD   = "\033[1m"

def ok(msg):     print(f"  {GREEN}✔{RESET}  {msg}")
def fail(msg):   print(f"  {RED}✘{RESET}  {msg}")
def info(msg):   print(f"  {CYAN}→{RESET}  {msg}")
def warn(msg):   print(f"  {YELLOW}!{RESET}  {msg}")
def header(msg): print(f"\n{BOLD}{msg}{RESET}")
def block(msg):  print(f"\n{RED}{BOLD}⛔  POLICY VIOLATION — BLOCKED{RESET}\n{msg}")

# Helpers

def load_manifest():
    with open(MANIFEST) as f:
        return yaml.safe_load(f)

def render_templates(manifest):
    os.makedirs(GEN_DIR, exist_ok=True)
    env = Environment(loader=FileSystemLoader(TMPL_DIR), keep_trailing_newline=True)
    for tmpl_name, out_path in [
        ("nginx.conf.j2",         NGINX_CONF),
        ("docker-compose.yml.j2", COMPOSE),
    ]:
        tmpl = env.get_template(tmpl_name)
        rendered = tmpl.render(**manifest, nginx_conf_path=NGINX_CONF)
        with open(out_path, "w") as f:
            f.write(rendered)
        info(f"Generated {os.path.relpath(out_path, ROOT)}")

def run(cmd, capture=False, check=True):
    if capture:
        result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
        if check and result.returncode != 0:
            return None, result.stderr.strip()
        return result.stdout.strip(), result.stderr.strip()
    else:
        return subprocess.run(cmd, shell=True, check=check)

def compose_cmd():
    out, _ = run("docker compose version", capture=True, check=False)
    if out:
        return f"docker compose -f {COMPOSE}"
    return f"docker-compose -f {COMPOSE}"

def update_manifest_mode(new_mode):
    with open(MANIFEST) as f:
        lines = f.readlines()
    with open(MANIFEST, "w") as f:
        in_services = False
        for line in lines:
            stripped = line.lstrip()
            if stripped.startswith("services:"):
                in_services = True
            elif stripped and not stripped.startswith("#") and line[0] not in (" ", "\t"):
                in_services = False
            if in_services and stripped.startswith("mode:"):
                indent = len(line) - len(line.lstrip())
                line = " " * indent + f"mode: {new_mode}\n"
            f.write(line)

def healthz_check(port, timeout=60):
    url = f"http://localhost:{port}/healthz"
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=3) as resp:
                if resp.status == 200:
                    return True
        except Exception:
            pass
        time.sleep(2)
    return False

def append_history(record: dict):
    """Append a JSON record to history.jsonl."""
    record["timestamp"] = datetime.now(timezone.utc).isoformat()
    with open(HISTORY, "a") as f:
        f.write(json.dumps(record) + "\n")

# OPA 

def opa_url(manifest):
    host = manifest["opa"]["host"]
    port = manifest["opa"]["port"]
    return f"http://{host}:{port}"

def query_opa(manifest, package_path, input_data):

    url = f"{opa_url(manifest)}/v1/data/{package_path}/decision"
    payload = json.dumps({"input": input_data}).encode()
    req = urllib.request.Request(
        url, data=payload,
        headers={"Content-Type": "application/json"},
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            body = json.loads(resp.read())
            result = body.get("result", {})
            allowed    = result.get("allow", False)
            violations = list(result.get("violations", []))
            return allowed, violations, None
    except urllib.error.URLError as e:
        return False, [], f"OPA unreachable: {e.reason}"
    except urllib.error.HTTPError as e:
        return False, [], f"OPA HTTP {e.code}: {e.reason}"
    except json.JSONDecodeError:
        return False, [], "OPA returned non-JSON response"
    except Exception as e:
        return False, [], f"Unexpected OPA error: {e}"

def get_host_stats():
    """Collect disk free (GB) and CPU load for OPA input."""
    disk  = psutil.disk_usage("/")
    load  = os.getloadavg()[0]   # 1-minute load average
    return {
        "disk_free_gb": round(disk.free / (1024 ** 3), 2),
        "cpu_load":     round(load, 4),
        "timestamp":    datetime.now(timezone.utc).isoformat(),
    }

def scrape_metrics(app_port):
    """
    Scrape /metrics from the app and parse Prometheus text format.
    Returns dict of {metric_name: float} for key metrics.
    """
    url = f"http://localhost:{app_port}/metrics"
    try:
        with urllib.request.urlopen(url, timeout=5) as resp:
            text = resp.read().decode("utf-8")
    except Exception as e:
        return None, str(e)

    metrics = {}
    for line in text.splitlines():
        if line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) >= 2:
            name_labels = parts[0]
            value = parts[-1]
            try:
                metrics[name_labels] = float(value)
            except ValueError:
                pass
    return metrics, None

def calc_error_rate_and_p99(metrics: dict):
    """
    From raw Prometheus metrics dict, compute:
    - error_rate_pct: % of requests that returned 5xx
    - p99_latency_ms: estimated P99 from histogram buckets
    """
    total_reqs = 0.0
    error_reqs = 0.0
    for key, val in metrics.items():
        if key.startswith("http_requests_total{"):
            total_reqs += val
            if 'status_code="5' in key:
                error_reqs += val

    error_rate_pct = (error_reqs / total_reqs * 100.0) if total_reqs > 0 else 0.0

    # P99 from histogram: find bucket where cumulative count >= 99% of total

    buckets = {}
    hist_count = 0.0
    for key, val in metrics.items():
        if key.startswith("http_request_duration_seconds_bucket{"):
            # extract le value
            try:
                le = float(key.split('le="')[1].rstrip('"}'))
                buckets[le] = val
            except (IndexError, ValueError):
                pass
        if key.startswith("http_request_duration_seconds_count"):
            hist_count = val

    p99_latency_ms = 0.0
    if buckets and hist_count > 0:
        target = hist_count * 0.99
        for le in sorted(buckets.keys()):
            if buckets[le] >= target:
                p99_latency_ms = le * 1000.0
                break

    return round(error_rate_pct, 4), round(p99_latency_ms, 2)

# Pre-flight OPA gates 

def gate_pre_deploy(manifest):
    """Query infra policy before deploy. Exit if blocked."""
    header("Policy Check: Pre-Deploy (Infrastructure)")
    stats = get_host_stats()
    info(f"Disk free: {stats['disk_free_gb']}GB  |  CPU load: {stats['cpu_load']}")

    allowed, violations, error = query_opa(manifest, "swiftdeploy/infra", stats)

    if error:
        # OPA unavailable — distinct failure mode, warn but don't crash

        warn(f"OPA unavailable ({error}) — skipping policy gate")
        append_history({"event": "opa_unavailable", "gate": "pre_deploy", "reason": error})
        return

    append_history({
        "event":      "policy_check",
        "gate":       "pre_deploy",
        "allowed":    allowed,
        "violations": violations,
        "input":      stats,
    })

    if not allowed:
        for v in violations:
            fail(v)
        block("\n".join(violations))
        sys.exit(1)

    ok("Infrastructure policy passed")

def gate_pre_promote(manifest, nginx_port, app_port):
    """Scrape /metrics and query canary policy before promote. Exit if blocked."""
    header("Policy Check: Pre-Promote (Canary Safety)")

    metrics, err = scrape_metrics(nginx_port)
    if err or metrics is None:
        warn(f"Could not scrape /metrics ({err}) — skipping policy gate")
        append_history({"event": "metrics_scrape_failed", "gate": "pre_promote", "reason": err})
        return

    error_rate_pct, p99_latency_ms = calc_error_rate_and_p99(metrics)
    info(f"Error rate: {error_rate_pct:.2f}%  |  P99 latency: {p99_latency_ms:.0f}ms")

    input_data = {
        "error_rate_pct":  error_rate_pct,
        "p99_latency_ms":  p99_latency_ms,
        "timestamp":       datetime.now(timezone.utc).isoformat(),
    }

    allowed, violations, error = query_opa(manifest, "swiftdeploy/canary", input_data)

    if error:
        warn(f"OPA unavailable ({error}) — skipping policy gate")
        append_history({"event": "opa_unavailable", "gate": "pre_promote", "reason": error})
        return

    append_history({
        "event":      "policy_check",
        "gate":       "pre_promote",
        "allowed":    allowed,
        "violations": violations,
        "input":      input_data,
    })

    if not allowed:
        for v in violations:
            fail(v)
        block("\n".join(violations))
        sys.exit(1)

    ok("Canary safety policy passed")

# Subcommands
def cmd_init():
    header("swiftdeploy init")
    manifest = load_manifest()

    # Ensure policies/ dir and opa-config.yaml exist
    policies_dir = os.path.join(ROOT, "policies")
    os.makedirs(policies_dir, exist_ok=True)
    opa_cfg = os.path.join(policies_dir, "opa-config.yaml")
    if not os.path.isfile(opa_cfg):
        with open(opa_cfg, "w") as f:
            f.write("decision_logs:\n  console: true\n")
        info("Created policies/opa-config.yaml")

    render_templates(manifest)
    ok("Init complete — configs generated")

def cmd_validate():
    header("swiftdeploy validate")
    passed = 0
    failed_count = 0

    # manifest valid
    label = "manifest.yaml exists and is valid YAML"
    if not os.path.isfile(MANIFEST):
        fail(label); failed_count += 1; manifest = None
    else:
        try:
            manifest = load_manifest(); ok(label); passed += 1
        except yaml.YAMLError as e:
            fail(f"{label}  ({e})"); failed_count += 1; manifest = None

    # required fields
    label = "All required fields present and non-empty"
    if manifest is None:
        fail(f"{label}  (skipped)"); failed_count += 1
    else:
        missing = []
        for section, fields in REQUIRED_FIELDS.items():
            if section not in manifest or not manifest[section]:
                missing.append(section); continue
            for field in fields:
                val = manifest[section].get(field)
                if val is None or str(val).strip() == "":
                    missing.append(f"{section}.{field}")
        if missing:
            fail(f"{label}  (missing: {', '.join(missing)})"); failed_count += 1
        else:
            ok(label); passed += 1

    # Docker image exists
    label = "Docker image exists locally"
    if manifest:
        image = manifest["services"]["image"]
        out, _ = run(f"docker image inspect {image}", capture=True, check=False)
        if out:
            ok(f"{label}  ({image})"); passed += 1
        else:
            fail(f"{label}  ({image} not found)"); failed_count += 1
    else:
        fail(f"{label}  (skipped)"); failed_count += 1

    # Nginx port free
    label = "Nginx port not already bound on host"
    if manifest:
        nginx_port = int(manifest["nginx"]["port"])
        try:
            s = socket.socket(); s.settimeout(1)
            s.connect(("127.0.0.1", nginx_port)); s.close()
            fail(f"{label}  (port {nginx_port} in use)"); failed_count += 1
        except (ConnectionRefusedError, OSError):
            ok(f"{label}  (port {nginx_port} free)"); passed += 1
    else:
        fail(f"{label}  (skipped)"); failed_count += 1

    # nginx.conf syntax
    label = "Generated nginx.conf is syntactically valid"
    if not os.path.isfile(NGINX_CONF):
        fail(f"{label}  (run init first)"); failed_count += 1
    else:
        out, err = run(
            f"docker run --rm -v {NGINX_CONF}:/etc/nginx/conf.d/default.conf:ro nginx:latest nginx -t 2>&1",
            capture=True, check=False
        )
        combined = (out or "") + (err or "")
        if "syntax is ok" in combined or "test is successful" in combined:
            ok(label); passed += 1
        else:
            fail(f"{label}  ({combined.splitlines()[0] if combined else 'unknown'})"); failed_count += 1

    # policies/ exists with .rego files
    
    label = "policies/ directory contains .rego files"
    policies_dir = os.path.join(ROOT, "policies")
    rego_files = [f for f in os.listdir(policies_dir) if f.endswith(".rego")] if os.path.isdir(policies_dir) else []
    if rego_files:
        ok(f"{label}  ({', '.join(rego_files)})"); passed += 1
    else:
        fail(f"{label}  (no .rego files found in policies/)"); failed_count += 1

    print()
    total = passed + failed_count
    if failed_count == 0:
        print(f"{GREEN}{BOLD}All {total} checks passed.{RESET}")
    else:
        print(f"{RED}{BOLD}{failed_count}/{total} checks failed.{RESET}")
        sys.exit(1)

def cmd_deploy():
    header("swiftdeploy deploy")
    manifest = load_manifest()

    # OPA gate FIRST
    gate_pre_deploy(manifest)

    info("Running init...")
    render_templates(manifest)

    dc = compose_cmd()
    info("Bringing up stack...")
    result = run(f"{dc} up -d --remove-orphans", check=False)
    if hasattr(result, "returncode") and result.returncode != 0:
        print(f"{RED}[ERROR] docker compose up failed.{RESET}", file=sys.stderr)
        sys.exit(1)

    nginx_port = int(manifest["nginx"]["port"])
    info(f"Waiting for health checks (up to 60s) on port {nginx_port}...")
    if healthz_check(nginx_port, timeout=60):
        ok(f"Stack is healthy at http://localhost:{nginx_port}")
        append_history({"event": "deploy", "mode": manifest["services"]["mode"]})
    else:
        print(f"{RED}[ERROR] Health check timed out after 60s.{RESET}", file=sys.stderr)
        run(f"{dc} logs --tail=30", check=False)
        sys.exit(1)

def cmd_promote(target_mode):
    header(f"swiftdeploy promote {target_mode}")

    if target_mode not in ("stable", "canary"):
        print(f"{RED}[ERROR] Mode must be 'stable' or 'canary'.{RESET}", file=sys.stderr)
        sys.exit(1)

    manifest = load_manifest()
    current_mode = manifest.get("services", {}).get("mode", "stable")
    if current_mode == target_mode:
        warn(f"Already in {target_mode} mode — nothing to do.")
        return

    nginx_port = int(manifest["nginx"]["port"])
    app_port   = int(manifest["services"]["port"])

    # Only gate pre-promote when going to stable (i.e. promoting canary → stable)
    if target_mode == "stable" and current_mode == "canary":
        gate_pre_promote(manifest, nginx_port, app_port)

    info(f"Switching {current_mode} → {target_mode}")
    update_manifest_mode(target_mode)
    ok("manifest.yaml updated")

    manifest = load_manifest()
    render_templates(manifest)
    ok("docker-compose.yml regenerated")

    dc = compose_cmd()
    info("Restarting app container...")
    run(f"{dc} up -d --no-deps --force-recreate app", check=False)

    time.sleep(3)
    url = f"http://localhost:{nginx_port}/healthz"
    try:
        with urllib.request.urlopen(url, timeout=10) as resp:
            import json as _json
            data = _json.loads(resp.read())
            actual_mode = data.get("mode", "unknown")
            if actual_mode == target_mode:
                ok(f"Confirmed: service is now in {BOLD}{target_mode}{RESET} mode")
                append_history({"event": "promote", "from": current_mode, "to": target_mode})
            else:
                warn(f"Expected mode={target_mode}, got mode={actual_mode}")
    except Exception as e:
        warn(f"Could not verify mode via /healthz: {e}")

def cmd_teardown(clean=False):
    header("swiftdeploy teardown")
    if not os.path.isfile(COMPOSE):
        warn("No docker-compose.yml found — nothing to tear down.")
    else:
        dc = compose_cmd()
        info("Stopping and removing containers, networks, volumes...")
        run(f"{dc} down -v --remove-orphans", check=False)
        ok("Stack torn down")
        append_history({"event": "teardown"})

    if clean:
        info("Removing generated configs...")
        for path in [NGINX_CONF, COMPOSE]:
            if os.path.isfile(path):
                os.remove(path)
                info(f"Deleted {os.path.relpath(path, ROOT)}")
        ok("Clean complete")

def cmd_status(manifest):
    """Live-refreshing terminal dashboard. Ctrl+C to exit."""
    header("swiftdeploy status  (Ctrl+C to stop)")
    nginx_port = int(manifest["nginx"]["port"])
    app_port   = int(manifest["services"]["port"])

    prev_total = 0.0
    prev_time  = time.time()

    try:
        while True:
            now = time.time()
            metrics, err = scrape_metrics(nginx_port)

            if err or metrics is None:
                warn(f"Cannot scrape /metrics: {err}")
                time.sleep(5)
                continue

            # Calculate req/s
            total_reqs = sum(v for k, v in metrics.items() if k.startswith("http_requests_total{"))
            elapsed    = now - prev_time
            req_s      = round((total_reqs - prev_total) / elapsed, 2) if elapsed > 0 else 0.0
            prev_total = total_reqs
            prev_time  = now

            error_rate_pct, p99_latency_ms = calc_error_rate_and_p99(metrics)

            # Uptime + mode + chaos
            uptime    = metrics.get("app_uptime_seconds", 0)
            app_mode  = "canary" if metrics.get("app_mode", 0) == 1 else "stable"
            chaos_val = int(metrics.get("chaos_active", 0))
            chaos_str = {0: "none", 1: "slow", 2: "error"}.get(chaos_val, "unknown")

            # Policy compliance
            host_stats = get_host_stats()
            infra_ok, infra_v, infra_err = query_opa(manifest, "swiftdeploy/infra", host_stats)
            canary_input = {
                "error_rate_pct":  error_rate_pct,
                "p99_latency_ms":  p99_latency_ms,
                "timestamp":       datetime.now(timezone.utc).isoformat(),
            }
            canary_ok, canary_v, canary_err = query_opa(manifest, "swiftdeploy/canary", canary_input)

            # Draw dashboard
            ts = datetime.now(timezone.utc).strftime("%H:%M:%S UTC")
            print(f"\033[2J\033[H", end="")  # clear screen
            print(f"{BOLD}╔══════════════════════════════════════════╗{RESET}")
            print(f"{BOLD}║       swiftdeploy STATUS  {ts}  ║{RESET}")
            print(f"{BOLD}╚══════════════════════════════════════════╝{RESET}")
            print(f"{BOLD} {RESET}")
            print()
            print(f"  Mode:       {BOLD}{app_mode.upper()}{RESET}")
            print(f"  Uptime:     {int(uptime)}s")
            print(f"  Chaos:      {chaos_str}")
            print()
            print(f"  {BOLD} Throughput {RESET}")
            print(f"  Req/s:      {req_s}")
            print(f"  Error Rate: {error_rate_pct:.2f}%")
            print(f"  P99 Latency:{p99_latency_ms:.0f}ms")
            print()
            print(f"  {BOLD}── Policy Compliance ──────────────────────{RESET}")
            infra_sym  = f"{GREEN}✔ PASS{RESET}" if infra_ok  else (f"{RED}✘ FAIL{RESET}" if not infra_err  else f"{YELLOW}? OPA DOWN{RESET}")
            canary_sym = f"{GREEN}✔ PASS{RESET}" if canary_ok else (f"{RED}✘ FAIL{RESET}" if not canary_err else f"{YELLOW}? OPA DOWN{RESET}")
            print(f"  Infrastructure Policy:  {infra_sym}")
            if infra_v:
                for v in infra_v: print(f"    {RED}↳ {v}{RESET}")
            print(f"  Canary Safety Policy:   {canary_sym}")
            if canary_v:
                for v in canary_v: print(f"    {RED}↳ {v}{RESET}")
            print()
            print(f"  {CYAN}Refreshing every 5s — Ctrl+C to exit{RESET}")

            # Append to history
            append_history({
                "event":          "status_scrape",
                "req_s":          req_s,
                "error_rate_pct": error_rate_pct,
                "p99_latency_ms": p99_latency_ms,
                "uptime":         int(uptime),
                "mode":           app_mode,
                "chaos":          chaos_str,
                "infra_policy":   {"pass": infra_ok, "violations": infra_v},
                "canary_policy":  {"pass": canary_ok, "violations": canary_v},
            })

            time.sleep(5)

    except KeyboardInterrupt:
        print(f"\n{CYAN}Status stopped.{RESET}")

def cmd_audit():
    """Parse history.jsonl and generate audit_report.md."""
    header("swiftdeploy audit")

    if not os.path.isfile(HISTORY):
        warn("No history.jsonl found — run 'status' first to generate data.")
        return

    events = []
    with open(HISTORY) as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    events.append(json.loads(line))
                except json.JSONDecodeError:
                    pass

    if not events:
        warn("history.jsonl is empty.")
        return

    # Build report sections 
    lines = [
        "# SwiftDeploy Audit Report",
        "",
        f"_Generated: {datetime.now(timezone.utc).isoformat()}_",
        f"_Total events: {len(events)}_",
        "",
        "---",
        "",
        "## Timeline",
        "",
        "| Timestamp | Event | Detail |",
        "|-----------|-------|--------|",
    ]

    lifecycle_events = ["deploy", "promote", "teardown", "policy_check", "opa_unavailable", "metrics_scrape_failed"]
    timeline_rows = [e for e in events if e.get("event") in lifecycle_events]

    for e in timeline_rows:
        ts     = e.get("timestamp", "unknown")[:19].replace("T", " ")
        event  = e.get("event", "")
        detail = ""
        if event == "deploy":
            detail = f"Deployed in `{e.get('mode', '?')}` mode"
        elif event == "promote":
            detail = f"Promoted `{e.get('from', '?')}` → `{e.get('to', '?')}`"
        elif event == "teardown":
            detail = "Stack torn down"
        elif event == "policy_check":
            status = "✅ PASS" if e.get("allowed") else "❌ FAIL"
            detail = f"Gate: `{e.get('gate', '?')}` — {status}"
        elif event == "opa_unavailable":
            detail = f"OPA DOWN — gate: `{e.get('gate', '?')}`"
        elif event == "metrics_scrape_failed":
            detail = f"Metrics scrape failed — {e.get('reason', '')}"
        lines.append(f"| {ts} | `{event}` | {detail} |")

    # Violations section 
    lines += [
        "",
        "---",
        "",
        "## Policy Violations",
        "",
    ]

    violations_found = False
    for e in events:
        if e.get("event") == "policy_check" and not e.get("allowed"):
            violations_found = True
            ts   = e.get("timestamp", "unknown")[:19].replace("T", " ")
            gate = e.get("gate", "unknown")
            lines.append(f"### {ts} — Gate: `{gate}`")
            lines.append("")
            for v in e.get("violations", []):
                lines.append(f"- ❌ {v}")
            lines.append("")

        if e.get("event") == "status_scrape":
            for policy in ["infra_policy", "canary_policy"]:
                pol = e.get(policy, {})
                if not pol.get("pass") and pol.get("violations"):
                    violations_found = True
                    ts   = e.get("timestamp", "unknown")[:19].replace("T", " ")
                    lines.append(f"### {ts} — Live check: `{policy}`")
                    lines.append("")
                    for v in pol["violations"]:
                        lines.append(f"- ❌ {v}")
                    lines.append("")

    if not violations_found:
        lines.append("_No policy violations recorded._")
        lines.append("")

    # Mode change summary 
    lines += [
        "---",
        "",
        "## Mode Changes",
        "",
        "| Timestamp | From | To |",
        "|-----------|------|----|",
    ]

    mode_events = [e for e in events if e.get("event") == "promote"]
    if mode_events:
        for e in mode_events:
            ts = e.get("timestamp", "")[:19].replace("T", " ")
            lines.append(f"| {ts} | `{e.get('from','?')}` | `{e.get('to','?')}` |")
    else:
        lines.append("| — | — | No mode changes recorded |")

    lines.append("")

    report = "\n".join(lines)
    with open(AUDIT_REPORT, "w") as f:
        f.write(report)

    ok(f"Audit report written to {os.path.relpath(AUDIT_REPORT, ROOT)}")
    info(f"Events processed: {len(events)}")

# Entry point 
USAGE = f"""{BOLD}swiftdeploy{RESET} — declarative container stack manager

Usage:
  ./swiftdeploy init
  ./swiftdeploy validate
  ./swiftdeploy deploy
  ./swiftdeploy promote <canary|stable>
  ./swiftdeploy status
  ./swiftdeploy audit
  ./swiftdeploy teardown [--clean]
"""

def main():
    args = sys.argv[1:]
    if not args:
        print(USAGE); sys.exit(0)

    cmd = args[0]

    if cmd == "init":
        cmd_init()
    elif cmd == "validate":
        cmd_validate()
    elif cmd == "deploy":
        cmd_deploy()
    elif cmd == "promote":
        if len(args) < 2:
            print(f"{RED}[ERROR] Usage: ./swiftdeploy promote <canary|stable>{RESET}", file=sys.stderr)
            sys.exit(1)
        cmd_promote(args[1])
    elif cmd == "status":
        manifest = load_manifest()
        cmd_status(manifest)
    elif cmd == "audit":
        cmd_audit()
    elif cmd == "teardown":
        cmd_teardown(clean="--clean" in args)
    else:
        print(f"{RED}[ERROR] Unknown command: {cmd}{RESET}\n", file=sys.stderr)
        print(USAGE)
        sys.exit(1)

if __name__ == "__main__":
    main()